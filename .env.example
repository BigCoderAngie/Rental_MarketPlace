# Copy to .env.local and fill in. `npx supabase start` prints the local values;
# for Vercel, use the values from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public address of the site, used in quote links sent over WhatsApp.
# Optional: without it the address comes from the request.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Feature switches (docs/RELEASING.md, "Feature flags"). "on" turns a feature
# on; anything else, or leaving it out, keeps it off. Set them per environment
# in Vercel: off in Production until the feature is ready, on in Preview.
NEXT_PUBLIC_FLAG_GOOGLE_SIGNIN=off
NEXT_PUBLIC_FLAG_NOTIFICATIONS=off
